# Copy this file to .env and fill in the real values before running

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/procureshield_db

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT (CHANGE THIS IN PRODUCTION — use a long random string)
JWT_SECRET_KEY=change_me_to_a_long_random_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI API Keys (Person B — add your key here)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# API Setu (Person A — real GSTIN + PAN adapters)
API_SETU_KEY=your_api_setu_key_here
