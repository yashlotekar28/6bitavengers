# Copy this file to .env and fill in the real values before running

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/procureshield_db

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT (CHANGE THIS IN PRODUCTION — use a long random string)
JWT_SECRET_KEY=change_me_to_a_long_random_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI API Keys — Gemini Flash is the primary AI engine (free tier available)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional fallback: OpenAI GPT-4o-mini
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# API Setu (Person A — real GSTIN + PAN adapters)
API_SETU_KEY=your_api_setu_key_here
